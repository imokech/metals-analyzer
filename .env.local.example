# Neon PostgreSQL Database URL
# Get this from https://neon.tech after creating a database
DATABASE_URL=postgresql://...

# Firecrawl API Key
# Get this from https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# Better-auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=...
# Public base URL of the app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Outbound HTTP proxy used to reach Iranian upstreams (IME, ice.ir, dastyar).
# Required. Accepts POST {url, data} and GET ?url=<encoded> and forwards the request.
PROXY_URL=https://your-proxy.example.com/proxy

# --- Optional overrides (defaults live in lib/config.ts) ---
# IME_API_URL=https://www.ime.co.ir/subsystems/ime/services/home/imedata.asmx/GetAmareMoamelatList
# ICE_API_URL=https://api.ice.ir/api/v1/markets/2/currencies/history/latest/?lang=fa
# DASTYAR_API_URL=https://api.dastyar.io/express/financial-item
# Daily snapshot schedule (node-cron syntax, server local time)
# SNAPSHOT_CRON=0 6 * * *
# Weeks of IME history to backfill on first boot / first manual refresh
# BACKFILL_WEEKS=12
